# ─── QRadar Connection ──────────────────────────────────────────────────────
# Required: hostname or IP of the QRadar console
QRADAR_HOST=https://your-qradar-host

# Authentication — choose ONE method:
# Option A: Authorized Service Token (recommended for production)
QRADAR_TOKEN=your-authorized-service-token-here

# Option B: Basic Auth credentials (used only when QRADAR_TOKEN is empty)
QRADAR_USERNAME=admin
QRADAR_PASSWORD=your-password

# Skip TLS verification for self-signed certs (set true for lab/dev environments)
QRADAR_VERIFY_SSL=false

# QRadar REST API version (default: 21.0)
QRADAR_API_VERSION=21.0

# ─── Sync / Polling ─────────────────────────────────────────────────────────
# Cron expression for how often to poll QRadar for changes (default: every minute)
SYNC_CRON=*/1 * * * *

# ─── Monitor Server ─────────────────────────────────────────────────────────
PORT=3000

# ─── Alerts ─────────────────────────────────────────────────────────────────
# Maximum number of alerts to keep in memory
ALERT_MAX_HISTORY=500

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
